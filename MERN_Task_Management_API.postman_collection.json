        },
        {
          "name": "400 Bad Request (Self-Deletion Blocked)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{admin_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{admin_id}}"
              ]
            },
            "description": "Trigger self-deletion block in admin controller."
          },
